# Ohne -f verwendet Docker Compose damit die Traefik-Datei.
COMPOSE_FILE=compose.traefik.yaml

# Nur Hostname, ohne https:// oder Pfad. DNS muss auf euren Traefik zeigen.
GLASSBOARD_HOST=whiteboard.example.com

# Vorhandenes Release; für bewusste Updates auf die gewünschte Version setzen.
GLASSBOARD_VERSION=1.0.0
